<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ReloadedILLink>false</ReloadedILLink>
    <AssemblyName>LivingWeapon</AssemblyName>
    <RootNamespace>LivingWeapon</RootNamespace>
  </PropertyGroup>

  <!-- DEV build flag: BuildLinked.ps1 passes -p:LwDev=true to define LWDEV, which switches Tuning
       to {1,2,3} kill thresholds and seeds every weapon to P3. Publish.ps1 omits it. -->
  <PropertyGroup Condition="'$(LwDev)' == 'true'">
    <DefineConstants>$(DefineConstants);LWDEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\gates\Logging\*.cs" Link="Gates\Logging\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Reloaded.Mod.Interfaces" Version="2.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Interface-only package; the IReloadedHooks instance is injected by the loader from the
         reloaded.sharedlib.hooks mod (declared in ModConfig.json), mirroring FFTHandsFree. -->
    <PackageReference Include="Reloaded.Hooks.Definitions" Version="1.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="meta.json"      CopyToOutputDirectory="PreserveNewest" Condition="Exists('meta.json')" />
    <None Include="treasure.json"  CopyToOutputDirectory="PreserveNewest" Condition="Exists('treasure.json')" />
    <!-- poach.json (species to carcass key and name map) rides the same build output copy as
         meta.json and treasure.json. PoachMap.cs loads it from modDir at runtime. -->
    <None Include="poach.json"     CopyToOutputDirectory="PreserveNewest" Condition="Exists('poach.json')" />
    <!-- The baked glow rim icon variants (tools/bake_glow_icons.py) and their manifest.json,
         read at runtime by Display/IconGlow.cs. The glob covers every ei_*_uitx_tN.tex plus
         manifest.json in one entry. -->
    <None Include="glow_icons\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('glow_icons')" />
  </ItemGroup>

</Project>
